{
  "name": "idam-slack-help-bot",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "start:dev": "set -o allexport; source .env; set +o allexport && node app.js",
    "watch": "nodemon app.js",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/unit",
    "test:functional": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/functional"
  },
  "author": "IDAM",
  "license": "MIT",
  "dependencies": {
    "@hmcts/properties-volume": "1.4.1",
    "@slack/bolt": "4.7.3",
    "config": "5.0.1",
    "jira-client": "^8.0.0",
    "js-yaml": "^5.0.0",
    "node-fetch": "^3.0.0",
    "node-fetch-retry": "^2.0.0"
  },
  "devDependencies": {
    "@types/jira-client": "^7.0.0",
    "jest": "^30.0.0",
    "jest-extended": "^7.0.0",
    "nodemon": "^3.0.0"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-extended"
    ]
  }
}
